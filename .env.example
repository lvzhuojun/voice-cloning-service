# ---------------------------------------------------------------
# Voice Cloning Service - Environment Variable Configuration
# Copy this file to .env and modify as needed
# ---------------------------------------------------------------

# Service listen address and port
HOST=0.0.0.0
PORT=8000

# Pretrained model storage directory (relative to project root)
MODEL_DIR=storage/pretrained_models

# Storage root directory (parent of uploads / models)
STORAGE_DIR=storage

# HuggingFace mirror (hf-mirror.com recommended for China)
HF_ENDPOINT=https://hf-mirror.com

# Log level: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# Upload file size limit (MB)
MAX_UPLOAD_SIZE_MB=200

# Audio duration limits (seconds)
MAX_AUDIO_DURATION_SECONDS=300
MIN_AUDIO_DURATION_SECONDS=3

# GPT-SoVITS configuration
GPTSOVITS_DIR=GPT-SoVITS
MODELS_DIR=storage/models
WHISPER_MODEL=medium
TRAINING_EPOCHS_GPT=15
TRAINING_EPOCHS_SOVITS=8
