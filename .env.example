# ──────────────────────────────────────────────
# 语音克隆服务 - 环境变量配置示例
# 复制本文件为 .env 并按实际情况修改
# ──────────────────────────────────────────────

# 服务监听地址和端口
HOST=0.0.0.0
PORT=8000

# 模型存储目录（相对项目根目录）
MODEL_DIR=storage/pretrained_models

# 音频/音色包存储根目录
STORAGE_DIR=storage

# HuggingFace 镜像源（国内环境推荐使用 hf-mirror.com）
HF_ENDPOINT=https://hf-mirror.com

# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# 上传文件大小限制（MB）
MAX_UPLOAD_SIZE_MB=100

# 音频时长限制（秒）
MAX_AUDIO_DURATION_SECONDS=60
MIN_AUDIO_DURATION_SECONDS=3
